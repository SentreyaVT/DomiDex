# Copy this file to keystore.properties and replace every placeholder locally.
# keystore.properties and all *.jks/*.keystore files are ignored by Git.
# On Windows, use an absolute path with forward slashes as shown below.
storeFile=C:/absolute/path/to/domidex-upload.jks
storePassword=CHANGE_ME
keyAlias=domidex-upload
keyPassword=CHANGE_ME

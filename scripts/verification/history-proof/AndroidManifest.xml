<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Only this disposable diagnostic package. No network permission or bootstrapping components. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
    <application android:label="DomiDex isolated history proof" tools:replace="android:label">
        <provider tools:node="removeAll" />
        <service tools:node="removeAll" />
        <receiver tools:node="removeAll" />
        <activity tools:node="removeAll" />
        <activity-alias tools:node="removeAll" />
    </application>
</manifest>

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function validImage() {
      return request.resource.contentType in ['image/jpeg', 'image/png']
        && request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024;
    }
    match /community-submissions/{uid}/{submissionId}/front.jpg {
      allow create: if signedIn() && request.auth.uid == uid && validImage()
        && firestore.exists(/databases/(default)/documents/communitySubmissions/$(submissionId))
        && firestore.get(/databases/(default)/documents/communitySubmissions/$(submissionId)).data.submitterUid == uid
        && firestore.get(/databases/(default)/documents/communitySubmissions/$(submissionId)).data.status == 'PENDING_UPLOAD';
      allow read: if signedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
